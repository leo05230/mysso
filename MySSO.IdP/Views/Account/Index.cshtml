@model MySSO.IdP.Models.LoginViewModel

@{
    ViewData["Title"] = "SSO 登入";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0">身分驗證中心 (IdP)</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">請輸入您的帳號密碼以繼續存取應用程式</p>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">使用者帳號</label>
                            <input asp-for="Username" class="form-control form-control-lg" placeholder="例如: leo" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">密碼</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="••••••••" required />
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">立即登入</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    <small class="text-secondary">測試帳號: leo / 密碼: password123</small>
                </div>
            </div>

            <div class="text-center mt-3">
                <a href="/" class="text-decoration-none text-muted">← 返回首頁</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}